{
  "name": "geop-level-one",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n WEB,API -c cyan,green \"pnpm dev:web\" \"pnpm dev:api\"",
    "dev:web": "next dev",
    "dev:api": "pnpm build:api && node --watch server/dist/main.js",
    "build": "next build",
    "build:api": "tsc -p server/tsconfig.json",
    "start": "next start",
    "start:api": "node server/dist/main.js",
    "typecheck": "pnpm typecheck:web && pnpm typecheck:api",
    "typecheck:web": "tsc --noEmit",
    "typecheck:api": "tsc -p server/tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "data:geography": "tsx server/scripts/import-natural-earth.ts",
    "data:conflicts": "tsx server/scripts/import-ucdp.ts"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.1.29",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.29",
    "@nestjs/platform-express": "^11.1.29",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.6",
    "@prisma/client": "^6.19.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/topojson-client": "^3.1.5",
    "adm-zip": "^0.6.0",
    "axios": "^1.19.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "csv-parse": "^7.0.2",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "helmet": "^8.3.0",
    "lucide-react": "^1.31.0",
    "maplibre-gl": "^6.3.0",
    "next": "^16.3.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "shapefile": "^0.6.6",
    "tailwindcss": "^4.3.3",
    "topojson-client": "^3.1.0",
    "typescript": "^7.0.2",
    "world-atlas": "^2.0.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/compression": "^1.8.1",
    "concurrently": "^10.0.4",
    "prisma": "^6.19.3",
    "tsx": "^4.23.12"
  }
}
